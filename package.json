{
  "name": "mcp-server-giallozafferano",
  "version": "0.2.0",
  "description": "Read-only MCP server for recipes, cooking, and Italian food: searches GialloZafferano.com and reads its public recipes, articles, videos, author profiles, and collection pages as structured data",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "giallozafferano",
    "recipes",
    "recipe-search",
    "italian-cuisine",
    "italian-recipes",
    "food",
    "cooking",
    "cucina",
    "ricette",
    "claude"
  ],
  "homepage": "https://github.com/Starlordzz/mcp-giallozafferano#readme",
  "bugs": {
    "url": "https://github.com/Starlordzz/mcp-giallozafferano/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starlordzz/mcp-giallozafferano.git"
  },
  "type": "module",
  "bin": {
    "mcp-server-giallozafferano": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "AI-DISCLOSURE.md",
    "AI-DISCLOSURE.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude tests/live/**",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
